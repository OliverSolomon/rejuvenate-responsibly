# Base URL used when building the links that travel by email.
NEXT_PUBLIC_SITE_URL=https://rejuvenateresponsibly.com

# Where assessments are written. Defaults to ./.data
RMI_DATA_DIR=

# Mailtrap. One token covers both services.
# Set MAILTRAP_INBOX_ID to catch everything in a test inbox; leave it unset to
# deliver for real from a verified sending domain.
MAILTRAP_TOKEN=
MAILTRAP_INBOX_ID=
MAILTRAP_FROM_EMAIL=no-reply@rejuvenateresponsibly.com
MAILTRAP_FROM_NAME=Rate My Impact
RMI_CONTACT_INBOX=info@rejuvenateresponsibly.com
# Set to false to stop all outbound email. The dashboard switch overrides this.
RMI_EMAIL_ENABLED=

# Everything from here through the OpenRouter block can also be saved from the
# dashboard (Settings). A value saved there is encrypted and wins over this file;
# clear it there and this file applies again.
#
# Master key for those encrypted dashboard values. Any long random string, for
# example: openssl rand -base64 32. Without it the dashboard cannot save secrets
# (the values in this file keep working). Keep it only here.
RMI_SETTINGS_KEY=

# Set to false to let people start an assessment without paying, for testing.
# The dashboard switch overrides this. Leave unset in production.
RMI_REQUIRE_PAYMENT=

# Pesapal. Leave PESAPAL_ENV unset for the sandbox, set it to live to go live.
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_ENV=
# Optional. Pins one IPN registration instead of letting the app register its own.
PESAPAL_IPN_ID=

# Report generation through OpenRouter, in two passes: a drafting model, then the
# humaniser model that edits the draft. Both default to low-cost models.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_HUMANIZER_MODEL=openai/gpt-4.1-mini

# Where submissions are stored. With the service role key below set, they go to
# Supabase; without it they go to a local file (RMI_DATA_DIR). Run both files in
# supabase/migrations first. RMI_STORAGE=file forces the file, which keeps a
# laptop off the live database.
# The service role key bypasses row level security. Server environment only,
# never a NEXT_PUBLIC_ variable and never committed.
SUPABASE_SERVICE_ROLE_KEY=
RMI_STORAGE=

# Supabase. Only the dashboard needs these; the public site runs without them.
# Run supabase/migrations/0001_rate_my_impact.sql in the SQL editor first, then
# add yourself to rmi_admins. Older projects call the browser key the anon key
# and NEXT_PUBLIC_SUPABASE_ANON_KEY is read as well.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
