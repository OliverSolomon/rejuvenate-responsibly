# Base URL used when building stakeholder survey links.
NEXT_PUBLIC_SITE_URL=https://rejuvenateresponsibly.com

# Pesapal checkout links. The per-tier variables win; the plain one is a fallback.
NEXT_PUBLIC_PESAPAL_URL=
NEXT_PUBLIC_PESAPAL_URL_ESSENTIAL=
NEXT_PUBLIC_PESAPAL_URL_PROFESSIONAL=

# Outbound email. Without a key, messages are logged rather than sent.
RESEND_API_KEY=
RMI_MAIL_FROM="Rate My Impact <no-reply@rejuvenateresponsibly.com>"
RMI_CONTACT_INBOX=info@rejuvenateresponsibly.com

# Where assessment submissions are written. Defaults to ./.data
RMI_DATA_DIR=
