# Base URL used when building the links that travel by email.
NEXT_PUBLIC_SITE_URL=https://rejuvenateresponsibly.com

# Where assessments are written. Defaults to ./.data
RMI_DATA_DIR=

# Outbound email. Without a key, messages are logged rather than sent, and the
# app tells the person to copy the link by hand instead of pretending it sent.
RESEND_API_KEY=
RMI_MAIL_FROM="Rate My Impact <no-reply@rejuvenateresponsibly.com>"
RMI_CONTACT_INBOX=info@rejuvenateresponsibly.com

# Pesapal. Leave PESAPAL_ENV unset for the sandbox, set it to live to go live.
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_ENV=
# Optional. Set it to pin one registration instead of letting the app register
# its own IPN URL on first use.
PESAPAL_IPN_ID=

# Report generation through OpenRouter.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
