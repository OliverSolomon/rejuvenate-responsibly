# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local RMI submission store
/.data

# design reference screenshots, not part of the site
/public/*.webp

# server env with live secrets (not matched by .env*)
/rejuvenateresponsibly.env

# but keep the documented example
!.env.example

# transfer archives, safe to delete
rr-*.tar.gz

# files the desktop app drops here
/Claude outputs/

# the WordCraft runtime, copied out of node_modules at build time
/public/wordcraft/


# Docs
/docs/*
# the site fonts, copied out of app/fonts at build time for report documents
/public/fonts/
